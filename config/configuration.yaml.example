# Skopiuj ten plik jako configuration.yaml dopiero w docelowym środowisku HA.
# Plik secrets.yaml pozostaje lokalny i nie jest wersjonowany.

default_config:

homeassistant:
  packages: !include_dir_named packages

lovelace:
  dashboards:
    ogrzewanie:
      mode: yaml
      title: Ogrzewanie
      icon: mdi:radiator
      show_in_sidebar: true
      filename: smarthome/config/dashboards/ogrzewanie.yaml
